flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces (one namespace)"]
        direction TB
        Agent([Agent or MCP client]):::edge
        MCP["MCP server<br/>remember, recall, forget"]:::edge
        CLI["CLI<br/>add, recall, consolidate"]:::edge
        API["AgentMemory facade<br/>Python API"]:::core
        CLI ~~~ Agent --> MCP --> API
    end

    subgraph Core["Memory engine"]
        direction TB
        Extract["Extractor<br/>rules or LLM provider"]:::core
        Merge["Merger<br/>supersede or contest"]:::control
        Score["Hybrid scorer<br/>4 weighted signals"]:::core
        Consolidate["Consolidation<br/>summarize, forget"]:::core
        Extract --> Merge ~~~ Score ~~~ Consolidate
    end

    subgraph State["SQLite store"]
        direction TB
        Episodic[("Episodic<br/>timestamped turns")]:::data
        Semantic[("Semantic<br/>facts + history")]:::data
        Procedural[("Procedural<br/>preferences")]:::data
        Index[("FTS5 index<br/>+ vector table")]:::data
        Episodic ~~~ Semantic
        Procedural ~~~ Index
    end

    subgraph Obs["Evaluation and outputs"]
        direction TB
        Recall["Recalled memories<br/>score breakdown + why"]:::obs
        Harness["Benchmark harness<br/>synthetic dataset"]:::obs
        Report["results.json and .md<br/>accuracy, recall@k"]:::obs
        Recall ~~~ Harness --> Report
    end

    Interfaces -->|turns, queries| Core
    Core -->|episodes, facts| State
    State -.->|BM25 + vector hits| Core
    Core -->|memories + why| Obs
