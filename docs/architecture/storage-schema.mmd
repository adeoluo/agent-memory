erDiagram
    memories ||--o| episodes : "kind = episodic"
    memories ||--o| facts : "kind = semantic"
    memories ||--o| preferences : "kind = procedural"
    memories ||--o| vectors : embedding
    memories ||--|| memories_fts : "FTS5 external content"
    memories {
        int id PK
        text namespace
        text kind
        text text
        real created_at
        real importance
        int access_count
        real last_accessed
        text status
    }
    episodes {
        int memory_id PK
        text session_id
        text role
        int consolidated
    }
    facts {
        int memory_id PK
        text subject
        text predicate
        text object
        real confidence
        real updated_at
        int evidence_count
        int superseded_by
    }
    preferences {
        int memory_id PK
        text key
        text value
        text provenance
        int superseded_by
    }
    vectors {
        int memory_id PK
        blob embedding
    }
    memories_fts {
        int rowid FK
        text text
    }
