# Copy to .env and fill in. Never commit .env.
# SQLite database used by the command-line interface and the MCP server.
AGENT_MEMORY_DATABASE=~/.agent-memory/memory.db
# Namespace (one per user or agent). The MCP server is bound to exactly one.
AGENT_MEMORY_NAMESPACE=default
# Only needed for LLMExtractor with AnthropicProvider (never used in tests).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
